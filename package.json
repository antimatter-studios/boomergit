{
  "name": "boomergit",
  "displayName": "BoomerGit",
  "description": "Old man shakes stick at crap git integrations \u2014 native git graph visualization",
  "version": "0.4.0",
  "publisher": "ChristopherThomas",
  "icon": "resources/old_man_yells_at_git_256.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/antimatter-studios/boomergit"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "resourceLabelFormatters": [
      {
        "scheme": "boomergit-file",
        "formatting": {
          "label": "${path} (${query.label})",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "boomergit-sidebar",
          "title": "BoomerGit",
          "icon": "resources/boomergit-icon.svg"
        }
      ]
    },
    "views": {
      "boomergit-sidebar": [
        {
          "id": "boomergit.worktrees",
          "name": "Worktrees",
          "when": "boomergit:graphOpen"
        },
        {
          "id": "boomergit.welcome",
          "name": "BoomerGit",
          "when": "!boomergit:graphOpen"
        },
        {
          "id": "boomergit.commitInfo",
          "name": "Commit Info",
          "type": "webview",
          "when": "boomergit:graphOpen"
        },
        {
          "id": "boomergit.changedFiles",
          "name": "Changed Files",
          "when": "boomergit:graphOpen"
        }
      ]
    },
    "languages": [
      {
        "id": "boomergit",
        "aliases": [
          "BoomerGit Graph"
        ]
      }
    ],
    "commands": [
      {
        "command": "boomergit.showGraph",
        "title": "BoomerGit: Show Graph"
      },
      {
        "command": "boomergit.checkoutRef",
        "title": "Checkout Ref"
      },
      {
        "command": "boomergit.deleteBranch",
        "title": "Delete Branch"
      },
      {
        "command": "boomergit.createBranch",
        "title": "Create Branch"
      },
      {
        "command": "boomergit.copyText",
        "title": "Copy Text"
      },
      {
        "command": "boomergit.openFileDiff",
        "title": "Show File Diff"
      },
      {
        "command": "boomergit.selectUp",
        "title": "Select Previous Row"
      },
      {
        "command": "boomergit.selectDown",
        "title": "Select Next Row"
      },
      {
        "command": "boomergit.refresh",
        "title": "BoomerGit: Refresh Graph",
        "icon": "$(refresh)"
      },
      {
        "command": "boomergit.toggleAutoRefresh",
        "title": "BoomerGit: Toggle Auto-Refresh"
      },
      {
        "command": "boomergit.revealWorktree",
        "title": "Reveal Worktree Commit"
      },
      {
        "command": "boomergit.openWorktree",
        "title": "Open Worktree in New Window"
      },
      {
        "command": "boomergit.copyWorktreePath",
        "title": "Copy Worktree Path"
      },
      {
        "command": "boomergit.createWorktree",
        "title": "Create Worktree from Branch"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "boomergit.refresh",
          "when": "resourceScheme == boomergit",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "boomergit.checkoutRef",
          "when": "false"
        },
        {
          "command": "boomergit.deleteBranch",
          "when": "false"
        },
        {
          "command": "boomergit.createBranch",
          "when": "false"
        },
        {
          "command": "boomergit.copyText",
          "when": "false"
        },
        {
          "command": "boomergit.openFileDiff",
          "when": "false"
        },
        {
          "command": "boomergit.selectUp",
          "when": "false"
        },
        {
          "command": "boomergit.selectDown",
          "when": "false"
        },
        {
          "command": "boomergit.revealWorktree",
          "when": "false"
        },
        {
          "command": "boomergit.openWorktree",
          "when": "false"
        },
        {
          "command": "boomergit.copyWorktreePath",
          "when": "false"
        },
        {
          "command": "boomergit.createWorktree",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "boomergit.openWorktree",
          "when": "view == boomergit.worktrees && viewItem == worktree",
          "group": "navigation"
        },
        {
          "command": "boomergit.copyWorktreePath",
          "when": "view == boomergit.worktrees",
          "group": "1_copy"
        }
      ]
    },
    "keybindings": [
      {
        "command": "boomergit.selectUp",
        "key": "up",
        "when": "resourceScheme == boomergit && editorTextFocus"
      },
      {
        "command": "boomergit.selectDown",
        "key": "down",
        "when": "resourceScheme == boomergit && editorTextFocus"
      }
    ],
    "configurationDefaults": {
      "[boomergit]": {
        "editor.lineHeight": 1.8,
        "editor.contextmenu": false,
        "editor.hover.above": false,
        "editor.minimap.enabled": false,
        "editor.scrollBeyondLastLine": false,
        "editor.hover.delay": 100,
        "editor.multiCursorModifier": "ctrlCmd",
        "editor.cursorStyle": "underline-thin",
        "editor.cursorBlinking": "solid",
        "editor.cursorWidth": 0,
        "editor.occurrencesHighlight": "off",
        "editor.selectionHighlight": false,
        "editor.renderLineHighlight": "none"
      }
    },
    "configuration": {
      "title": "BoomerGit",
      "properties": {
        "boomergit.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh the graph when the repository's refs change (watches .git). Toggle from the status bar while the graph is open."
        },
        "boomergit.worktrees.location": {
          "type": "string",
          "enum": [
            "sibling",
            "custom"
          ],
          "enumDescriptions": [
            "Next to the repository, named <repo>-<branch>. Keeps worktrees outside the repository, so there is nothing to gitignore and the editor never shows them as stray folders.",
            "Inside the directory given by #boomergit.worktrees.customPath#."
          ],
          "default": "sibling",
          "description": "Where BoomerGit creates new worktrees. The path is always shown for confirmation before anything is created."
        },
        "boomergit.worktrees.customPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Parent directory for new worktrees when `#boomergit.worktrees.location#` is `custom`. `${workspaceFolder}` expands to the repository root, and a relative path is resolved against it.\n\nFor an inside-the-repository layout use `${workspaceFolder}/.worktrees` and add `.worktrees/` to your `.gitignore`.\n\nLeft empty, this falls back to the sibling layout rather than creating a worktree somewhere unexpected."
        },
        "boomergit.worktrees.rowStyle": {
          "type": "string",
          "enum": [
            "background",
            "ring",
            "both",
            "none"
          ],
          "enumDescriptions": [
            "Tint the whole row green. The most obvious, but it claims the row's background, which the checked-out branch row and a compare selection already use \u2014 on a row that is both, which one shows is up to VS Code.",
            "Draw a green ring around the commit dot. Subtler, but composes with everything: the inverted active row and a compare selection both still show through.",
            "Both the tint and the ring.",
            "Neither. The W badge and the overview-ruler tick still mark the row."
          ],
          "default": "background",
          "description": "How the graph marks a commit that another working tree has checked out. The W badge and the overview-ruler tick are always shown."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "visual-check": "node scripts/dev/visual-check.mjs",
    "package": "npm run build && mkdir -p build && vsce package --out build/",
    "publish:vscode": "vsce publish --packagePath build/boomergit-*.vsix",
    "publish:openvsx": "ovsx publish build/boomergit-*.vsix",
    "publish:all": "npm run publish:vscode && npm run publish:openvsx",
    "release:patch": "node scripts/release-prepare.mjs patch",
    "release:minor": "node scripts/release-prepare.mjs minor",
    "release:major": "node scripts/release-prepare.mjs major"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.0",
    "ovsx": "^0.10.9",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9"
  }
}
