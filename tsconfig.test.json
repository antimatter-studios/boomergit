{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "types": ["node"],
    // Vitest loads these as ESM and bundles them, so top-level await is fine
    // here even though the package itself is CommonJS.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*", "test/**/*"]
}
